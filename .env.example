# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
DAIF_MODEL=claude-opus-5
DAIF_EFFORT=medium
DAIF_MAX_TOKENS=4000

# ---- الحواجز ----
DAIF_CONFIDENCE_THRESHOLD=0.7
DAIF_MAX_SENTENCES=3

# ---- التخزين ----
DAIF_DATABASE_URL=sqlite:///var/daif.db

# ---- واتساب (WhatsApp Cloud API) ----
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=اختر-نصًا-عشوائيًا-طويلًا
WHATSAPP_APP_SECRET=من-إعدادات-تطبيق-Meta

# ---- تشفير الأسرار (إلزامي في الإنتاج) ----
# ولّده بـ: python -c "import secrets;print(secrets.token_urlsafe(48))"
DAIF_SECRET_KEY=مفتاح-عشوائي-طويل-لتشفير-رموز-واتساب

# ---- الفوترة ----
DAIF_SELLER_NAME=ضيف لتقنية الضيافة
DAIF_SELLER_VAT=300000000000003

# ---- لوحة التحكم ----
DAIF_DASHBOARD_SECRET=مفتاح-عشوائي-طويل-لتوقيع-الجلسات
DAIF_DEFAULT_LOCALE=ar
